//QUERIES SEPARATED BY NAMES WITH CAPITAL LETTERS


//UNWEIGHTED SHORTEST PATH
LET shortestPath = (
    FOR v, e IN OUTBOUND SHORTEST_PATH @from TO @to 
        GRAPH 'Graph'
        RETURN { station: v.stationName, edge_length: e.length }
)

LET stations = UNIQUE(FOR path IN shortestPath RETURN path.station)
LET totalLength = SUM(FOR path IN shortestPath RETURN path.edge_length)
LET stationsCount = LENGTH(stations)

RETURN { stations, totalLength, stationsCount }


//WEIGHTED SHORTEST PATH
LET shortestPath = (
    FOR v, e IN OUTBOUND SHORTEST_PATH @from TO @to 
        GRAPH 'Graph'
         OPTIONS {weightAttribute: 'length'}
        RETURN { station: v.stationName, edge_length: e.length }
)

LET stations = UNIQUE(FOR path IN shortestPath RETURN path.station)
LET totalLength = SUM(FOR path IN shortestPath RETURN path.edge_length)
LET stationsCount = LENGTH (stations)

RETURN { stations, totalLength, stationsCount }