//Q1-4
//hloubka x specifikovana pomoci FOR f IN 1..x
LET friends = (
    FOR f IN 1..2 ANY "User/1" FRIENDS
    OPTIONS { uniqueVertices: "global", order: "bfs" }
        RETURN f
)
RETURN COUNT_DISTINCT(friends)


//Q5
FOR p IN ANY SHORTEST_PATH
"User/12000" TO "User/1047" FRIENDS
    RETURN p


//Q5
FOR p IN OUTBOUND SHORTEST_PATH
"User/12000" TO "User/1047" FRIENDS
    RETURN p


//Q7
FOR u IN User
    FILTER u.age > 75 AND STARTS_WITH(u.firstName, "Ma")
    COLLECT WITH COUNT INTO c
    RETURN c


//Q8
FOR u IN User
    FILTER u.firstName == "James"
    COLLECT AGGREGATE a=AVG(u.age)
    RETURN a