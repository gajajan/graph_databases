//QUERIES SEPARATED BY NAMES WITH CAPITAL LETTERS


//FIRST NEIGHBORHOOD
FOR f IN OUTBOUND @user FOLLOWS
    RETURN f


//SECOND NEIGHBORHOOD
FOR fof IN 2..2 OUTBOUND @user FOLLOWS
    RETURN DISTINCT fof


//SECOND NEIGHBORHOOD WITHOUT FIRST
//first neighborhood
LET f = (
    FOR v IN OUTBOUND @user FOLLOWS
        RETURN DISTINCT v
)

FOR fof IN 2..2 OUTBOUND @user FOLLOWS
    FILTER fof._id != @user
    FILTER fof not in f
    RETURN DISTINCT fof


//VISITED DESTINATIONS
//returns a destination name and
// a number indicating how many times user visited specific destination
FOR d IN 2..2 OUTBOUND @user PARTICIPATED, LED_TO
    COLLECT name = d.destinationName WITH COUNT INTO count
    SORT count DESC, name
    RETURN {name, count}


//CO-TRAVELERS
//returns user's id and name
FOR journey IN OUTBOUND @user PARTICIPATED
    FOR f IN INBOUND journey PARTICIPATED
        FILTER f._id != @user
        COLLECT key = f._key, firstName = f.firstName, lastName = f.lastName WITH COUNT INTO count
        SORT firstName, lastName
        RETURN { key, firstName, lastName, count }


//DESTINATIONS OFFERING ALL ACTIVITIES IN LIST
FOR d IN Destination
    LET matching_activities = (
        FOR v IN OUTBOUND d OFFERS
            FILTER v.activityName IN @activity_list
            RETURN DISTINCT v
    )
    FILTER LENGTH(matching_activities) == LENGTH(@activity_list)
    RETURN d


//DESTINATION RECOMMENDATION BASED ON ACTIVITY LIST
//destinations which offer all activities in list
LET destinations = (
    FOR d IN Destination
        LET matching_activities = (
            FOR v IN OUTBOUND d OFFERS
                FILTER v.activityName IN @activity_list
                RETURN DISTINCT v
        )
        FILTER LENGTH(matching_activities) == LENGTH(@activity_list)
        RETURN DISTINCT d
)
//destinations that the user has not visited
LET visited = (
  FOR d IN 2..2 OUTBOUND @user PARTICIPATED, LED_TO
    RETURN d
)
LET unvisited = MINUS(destinations, visited)
//average rating for those destinations
FOR d IN unvisited
    LET averageRating = AVG(
        FOR r IN 2..2 INBOUND d LED_TO, ABOUT
            RETURN r.rating
    )
    SORT averageRating DESC
    LIMIT 3
    RETURN {name: d.destinationName, rating: averageRating ? : 'not rated'}


//DESTINATIONS OFFERING ACTIVITIES THAT USER LIKES
FOR d IN 2..2 OUTBOUND @user LIKES, INBOUND OFFERS
    COLLECT name = d.destinationName WITH COUNT INTO count
    SORT count DESC, name
    RETURN {name, count}


//DESTINATION RECOMMENDATION BASED ON USER'S FAVOURITE ACTIVITIES
//destinations that offer activities that the user likes
LET destinations = (
    FOR d IN 2..2 OUTBOUND @user LIKES, INBOUND OFFERS
        RETURN DISTINCT d
)
//destinations that the user has visited
LET visited = (
  FOR d IN 2..2 OUTBOUND @user PARTICIPATED, LED_TO
    RETURN d
)
LET unvisited = MINUS(destinations, visited)
//average rating for those destinations
FOR d IN unvisited
    LET averageRating = AVG(
        FOR r IN 2..2 INBOUND d LED_TO, ABOUT
            RETURN r.rating
    )
    SORT averageRating DESC
    LIMIT 3
    RETURN {name: d.destinationName, averageRating: averageRating ? : 'not rated'}


//THE MOST FAVOURITE MONTH FOR VISITING SPECIFIC DESTINATION
//returns a number indicating the month of the year
//and the input destination rating for that month
FOR j IN INBOUND @destination LED_TO
    COLLECT monthAggregate = DATE_MONTH(j.journeyStart) INTO months
    LET monthJourneys = (
        FOR m IN months
            RETURN m.j._id
    )
    LET averageRating = AVG(
        FOR j IN monthJourneys
            FOR r IN INBOUND j ABOUT
                RETURN r.rating
    )
    SORT averageRating DESC
    LIMIT 1
    RETURN { month: monthAggregate, averageRating: averageRating ? : 'not rated' }


//TEXT SEARCH
//returns users whose name contains the input substring
FOR u IN User
    FILTER CONTAINS(UPPER(u.firstName), UPPER(@substr))
        OR  CONTAINS(UPPER(u.lastName), UPPER(@substr))
    RETURN u
