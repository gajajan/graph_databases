{
  "config": {"parallel": true},
    "source": { "file": { "path": "/csv/Youtube/users.csv" } },
    "extractor": { "csv": {
      "columns": ["userId:integer"]
    } 
  },
    "transformers": [
      { "vertex": { "class": "User" } }
    ],
    "loader": {
      "orientdb": {
        "dbURL": "plocal:../databases/Youtube",
        "dbType": "graph",
        "dbUser": "root",
        "dbPassword": "root",
        "tx": false,
        "wal": false,
        "batchCommit": 1000,
        "useLightweightEdges": false,
        "classes": [
          {"name": "User", "extends": "V"}
        ],
        "indexes": [
          {"class":"User", "fields":["userId:integer"], "type":"UNIQUE" }
        ]
      }
    }
  }