{
    "source": { "file": { "path": "/csv/TravelEnthusiastNetwork/wrote_about.csv" } },
    "extractor": {
      "csv": {
        "columns": ["userId:integer","ratingId:integer","journeyId:integer"]
      }
    },
    "transformers": [
      { "merge": { "joinFieldName": "ratingId", "lookup": "Rating.ratingId" } },
      { "edge": { "class": "WROTE",
                  "joinFieldName": "userId",
                  "lookup": "User.userId",
                  "direction": "in" 
                }
      },
      { "edge": { "class": "ABOUT",
                  "joinFieldName": "journeyId",
                  "lookup": "Journey.journeyId",
                  "direction": "out" 
                }
      },
      { "field": { "fieldNames": ["userId"], "operation": "remove" } },
      { "field": { "fieldNames": ["journeyId"], "operation": "remove" } }
    ],
    "loader": {
      "orientdb": {
         "dbURL": "plocal:../databases/TravelEnthusiastNetwork",
         "dbUser": "root",
         "dbPassword": "root",
         "dbType": "graph",
         "classes": [
            {"name": "User", "extends": "V"},
            {"name": "Rating", "extends": "V"},
            {"name": "Journey", "extends": "V"},
            {"name": "WROTE", "extends": "E"},
            {"name": "ABOUT", "extends": "E"}
         ]
      }
    }
  }