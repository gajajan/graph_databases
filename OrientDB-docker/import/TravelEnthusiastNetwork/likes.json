{
    "source": { "file": { "path": "/csv/TravelEnthusiastNetwork/likes.csv" } },
    "extractor": {
      "csv": {
        "columns": ["userId:integer","activityId:integer"]
      } 
    },
    "transformers": [
      { "merge": { "joinFieldName": "userId", "lookup": "User.userId" } },
      { "edge": { "class": "LIKES",
                  "joinFieldName": "activityId",
                  "lookup": "TravelActivity.activityId",
                  "direction": "out" 
                }
      },
      { "field": { "fieldNames": ["activityId"], "operation": "remove" } }
    ],
    "loader": {
      "orientdb": {
         "dbURL": "plocal:../databases/TravelEnthusiastNetwork",
         "dbUser": "root",
         "dbPassword": "root",
         "dbType": "graph",
         "classes": [
            {"name": "User", "extends": "V"},
            {"name": "TravelActivity", "extends": "V"},
            {"name": "LIKES", "extends": "E"}
         ]
      }
    }
  }