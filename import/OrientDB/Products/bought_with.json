{
    "source": { "file": { "path": "C:/Users/gajaj/Desktop/School/Bachelor/graph_databases/csv/Products/bought_with.csv" } },
    "extractor": { "csv": {} },
    "transformers": [
      { "merge": { "joinFieldName": "source", "lookup": "Product.productId" } },
      { "vertex": {"class": "Product"} },
      { "edge": { "class": "BOUGHT_WITH",
                  "joinFieldName": "dest",
                  "lookup": "Product.productId",
                  "direction": "out",
                  "edgeFields":    { "weight": "${input.weight}" }
                }
      },
      { "field": { "fieldNames": ["source", "dest"], "operation": "remove" } }
    ],
    "loader": {
      "orientdb": {
         "dbURL": "plocal:../databases/Products",
         "dbUser": "root",
         "dbPassword": "root",
         "dbType": "graph",
         "classes": [
            {"name": "Product", "extends": "V"},
            {"name": "BOUGHT_WITH", "extends": "E"}
         ]
      }
    }
  }