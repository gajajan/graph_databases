{
    "source": { "file": { "path": "C:/Users/gajaj/Desktop/School/Bachelor/graph_databases/csv/TravelEnthusiastNetwork/offers.csv" } },
    "extractor": {
      "csv": {
        "columns": ["destinationId:integer","activityName:string"]
      }
    },
    "transformers": [
      { "merge": { "joinFieldName": "destinationId", "lookup": "Destination.destinationId" } },
      { "edge": { "class": "OFFERS",
                    "joinFieldName": "activityName",
                    "lookup": "TravelActivity.activityName",
                    "direction": "out" 
                }
      },
      { "field": { "fieldNames": ["activityName"], "operation": "remove" } }
    ],
    "loader": {
      "orientdb": {
         "dbURL": "plocal:../databases/TravelEnthusiastNetwork",
         "dbUser": "root",
         "dbPassword": "root",
         "dbType": "graph",
         "classes": [
            {"name": "Destination", "extends": "V"},
            {"name": "TravelActivity", "extends": "V"},
            {"name": "OFFERS", "extends": "E"}
         ]
      }
    }
  }