{
    "source": { "file": { "path": "C:/Users/gajaj/Desktop/School/Bachelor/graph_databases/csv/TravelEnthusiastNetwork/likes.csv" } },
    "extractor": {
      "csv": {
        "columns": ["userId:integer","activityName:string"]
      } 
    },
    "transformers": [
      { "merge": { "joinFieldName": "userId", "lookup": "User.userId" } },
      { "edge": { "class": "LIKES",
                  "joinFieldName": "activityName",
                  "lookup": "TravelActivity.activityName",
                  "direction": "out" 
                }
      },
      { "field": { "fieldNames": ["activityName"], "operation": "remove" } }
    ],
    "loader": {
      "orientdb": {
         "dbURL": "plocal:../databases/TravelEnthusiastNetwork",
         "dbUser": "root",
         "dbPassword": "root",
         "dbType": "graph",
         "classes": [
            {"name": "User", "extends": "V"},
            {"name": "TravelActivity", "extends": "V"},
            {"name": "LIKES", "extends": "E"}
         ]
      }
    }
  }