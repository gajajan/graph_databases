{
    "source": { "file": { "path": "C:/Users/gajaj/Desktop/School/Bachelor/graph_databases/csv/TravelEnthusiastNetwork/led_to.csv" } },
    "extractor": { "csv": {} },
    "transformers": [
      { "merge": { "joinFieldName": "journeyId", "lookup": "Journey.journeyId" } },
      { "edge": { "class": "LED_TO",
                  "joinFieldName": "destinationId",
                  "lookup": "Destination.destinationId",
                  "direction": "out",
                  "edgeFields":    { "startDate": "${input.startDate}", "endDate": "${input.endDate}" }
                }
      },
      { "field": { "fieldNames": ["destinationId", "startDate", "endDate"], "operation": "remove" } }
    ],
    "loader": {
      "orientdb": {
         "dbURL": "plocal:../databases/TravelEnthusiastNetwork",
         "dbUser": "root",
         "dbPassword": "root",
         "dbType": "graph",
         "classes": [
            {"name": "Journey", "extends": "V"},
            {"name": "Destination", "extends": "V"},
            {"name": "LED_TO", "extends": "E"}
         ]
      }
    }
  }